<?xml version="1.0" encoding="utf-8"?>
<!-- Login cookies and sessions never leave the device. Mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="spotify_session.xml"/>
        <exclude domain="sharedpref" path="Deezer.xml"/>
        <exclude domain="sharedpref" path="SpotiflacSession.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="spotify_session.xml"/>
        <exclude domain="sharedpref" path="Deezer.xml"/>
        <exclude domain="sharedpref" path="SpotiflacSession.xml"/>
    </device-transfer>
</data-extraction-rules>
